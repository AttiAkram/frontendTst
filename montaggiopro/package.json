{
  "name": "montaggiopro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":          "vite",
    "build":        "tsc && vite build",
    "preview":      "vite preview",
    "type-check":   "tsc --noEmit",
    "backend:up":   "cd backend && docker-compose up -d",
    "backend:down": "cd backend && docker-compose down",
    "backend:logs": "cd backend && docker-compose logs -f backend",
    "backend:migrate": "cd backend && docker-compose exec backend python manage.py migrate",
    "dev:all":      "npm run backend:up && npm run dev"
  },
  "dependencies": {
    "react":        "^18.3.1",
    "react-dom":    "^18.3.1",
    "lucide-react": "^0.383.0"
  },
  "devDependencies": {
    "@types/react":        "^18.3.1",
    "@types/react-dom":    "^18.3.1",
    "@vitejs/plugin-react":"^4.3.1",
    "typescript":          "^5.4.5",
    "vite":                "^5.3.1"
  }
}
