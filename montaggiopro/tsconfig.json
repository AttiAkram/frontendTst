{
  "compilerOptions": {
    "target":            "ESNext",
    "lib":               ["DOM", "DOM.Iterable", "ESNext"],
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "jsx":               "react-jsx",
    "strict":            true,
    "noUnusedLocals":    true,
    "noUnusedParameters":true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "noEmit":            true
  },
  "include": ["src"]
}
