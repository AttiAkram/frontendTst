{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ecommerce && npm install --no-audit --no-fund",
  "buildCommand": "cd ecommerce && npm run build",
  "outputDirectory": "ecommerce/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
